<?xml version="1.0" encoding="utf-8"?>
<!-- The wallpaper keeps no data of its own: nothing to back up or transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
